{
  "name": "@nuxtjp/flow",
  "version": "0.1.0",
  "description": "Typed, client-only Vue Flow integration for Nuxt with SSR-safe boundaries",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "runtime": [
        "./dist/runtime/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build prepare && nuxt prepare test/fixtures/basic",
    "dev": "nuxt dev test/fixtures/basic",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "check": "npm run lint && npm run typecheck && npm run typecheck:fixture && npm run test && npm run prepack",
    "typecheck:fixture": "nuxt typecheck test/fixtures/basic"
  },
  "dependencies": {
    "@nuxt/kit": "4.6.1",
    "@vue-flow/core": "1.48.2"
  },
  "peerDependencies": {
    "nuxt": "~4.6.1",
    "vue": "~3.5.44"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "happy-dom": "^20.0.0",
    "nuxt": "4.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxtjp/flow.git"
  },
  "bugs": {
    "url": "https://github.com/nuxtjp/flow/issues"
  },
  "homepage": "https://github.com/nuxtjp/flow#readme"
}
